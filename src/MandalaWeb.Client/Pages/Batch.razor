@page "/batch"
@inject DesignApi Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Batch · Mandala Maker</PageTitle>

<header class="toolbar">
    <div class="brand">Mandala Maker</div>
    <div class="group">
        <a class="button" href="">← Back to designing</a>
        <a class="button" href="gallery">🖼 Gallery</a>
    </div>
    <div class="group">
        <label class="inline">Style
            <select @bind="style" disabled="@busy">
                <option value="intricate">✦ Intricate</option>
                <option value="lineart">✏ Line art</option>
            </select>
        </label>
        <label class="inline">Detail
            <select @bind="difficulty" disabled="@busy">
                <option value="Simple">Simple</option>
                <option value="Medium">Medium</option>
                <option value="Intricate">Intricate</option>
            </select>
        </label>
        <label class="inline">How many
            <select @bind="howMany" disabled="@busy">
                <option value="6">6</option>
                <option value="12">12</option>
                <option value="24">24</option>
            </select>
        </label>
        <button class="primary" @onclick="GenerateAll" disabled="@busy">@(busy ? $"Making {made} of {target}…" : "✦ Generate")</button>
    </div>
    <div class="group">
        <button @onclick="SelectAll" disabled="@(busy || items.All(i => i.Picked || i.SavedId != null))">Select all</button>
        <button @onclick="SelectNone" disabled="@(busy || PickedCount == 0)">Select none</button>
        <button @onclick="ReplaceUnpicked" disabled="@(busy || items.Count == 0 || items.All(i => i.Picked || i.SavedId != null))"
                title="Keep the ones you've picked and make new designs in place of the rest">↻ Replace the rest</button>
        <button class="accent" @onclick="SavePicked" disabled="@(busy || PickedCount == 0)">💾 Save @PickedCount picked</button>
    </div>
</header>

<main class="batch-page">
    <p class="message">@message</p>

    @if (items.Count == 0 && !busy)
    {
        <div class="empty">
            <h2>Make a batch of designs</h2>
            <p>Generate a grid of mandalas, click the ones you like, and save them all in one go. Unpicked ones can be replaced with new ones as often as you like.</p>
        </div>
    }

    <div class="batch-grid">
        @foreach (var item in items)
        {
            var it = item;
            <div class="batch-tile @(it.Picked ? "picked" : "") @(it.SavedId != null ? "saved" : "")" @onclick="() => TogglePick(it)">
                <img src="@it.DataUrl" alt="Generated mandala" />
                <span class="pick">@(it.SavedId != null ? "Saved" : it.Picked ? "✓" : "")</span>
                <div class="tile-actions" @onclick:stopPropagation="true">
                    @if (it.SavedId is long id)
                    {
                        <span class="saved-name">@it.Name</span>
                        <button @onclick="() => Open(it)" title="See it big and zoom in">🔍</button>
                        <button @onclick='() => Nav.NavigateTo($"d/{id}")'>Edit</button>
                    }
                    else
                    {
                        <button @onclick="() => Open(it)" title="See it big and zoom in">🔍</button>
                        <button @onclick="() => Reroll(it)" disabled="@busy" title="Replace just this one">↻</button>
                        <button @onclick="() => EditOne(it)" disabled="@busy" title="Save it and open it in the editor">Edit</button>
                    }
                </div>
            </div>
        }
    </div>
</main>

@if (viewing is Item v)
{
    int pos = items.IndexOf(v);
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal zoom-modal" tabindex="0" @ref="zoomBox" @onkeydown="ZoomKey" @onclick:stopPropagation="true">
            <div class="preview-head">
                <h3>Design @(pos + 1) of @items.Count</h3>
                <span class="help">Click the picture to zoom in, then scroll to look around. ← → for the next one.</span>
                <div class="row end" style="margin:0">
                    <button @onclick="() => Step(-1)" disabled="@(pos <= 0)">←</button>
                    <button @onclick="() => Step(1)" disabled="@(pos >= items.Count - 1)">→</button>
                    <button @onclick="() => ZoomBy(-1)" disabled="@(zoom <= 1)">−</button>
                    <span class="zoom-level">@(zoom)×</span>
                    <button @onclick="() => ZoomBy(1)" disabled="@(zoom >= 6)">+</button>
                    @if (v.SavedId == null)
                    {
                        <button @onclick="() => Reroll(v)" disabled="@busy" title="Replace this one">↻</button>
                        <button class="@(v.Picked ? "accent" : "primary")" @onclick="() => v.Picked = !v.Picked">@(v.Picked ? "✓ Picked" : "Pick it")</button>
                    }
                    else
                    {
                        <span class="saved-name">Saved as @v.Name</span>
                    }
                    <button @onclick="Close">Close</button>
                </div>
            </div>
            <div class="zoom-view" @ref="zoomView">
                <img src="@v.DataUrl" alt="Generated mandala" style="@(zoom == 1 ? "" : $"width:{zoom * 100}%")" class="@(zoom == 1 ? "fit" : zoom >= 6 ? "max" : "")" @onclick="ZoomAtClick" />
            </div>
        </div>
    </div>
}

@code {
    private sealed class Item
    {
        public MandalaDocument Doc = new();
        public string Svg = "";
        public string DataUrl = "";
        public bool Picked;
        public long? SavedId;
        public string? Name;
    }

    private const string SettingsKey = "mandala.settings";
    private readonly Random rng = new();
    private readonly List<Item> items = new();
    private AppSettings settings = new();
    private string style = "intricate";
    private Difficulty difficulty = Difficulty.Intricate;
    private int howMany = 12;
    private bool busy;
    private int made, target;
    private string message = "";

    private Item? viewing;
    private int zoom = 1;
    private ElementReference zoomBox, zoomView;
    private double[]? focus; // the point (as fractions of the picture) to keep centered after the next zoom

    private async Task Open(Item item)
    {
        viewing = item;
        zoom = 1;
        StateHasChanged();
        await Task.Yield();
        try { await zoomBox.FocusAsync(); } catch (Exception) { } // so the arrow and Esc keys work right away
    }

    private void Close() => viewing = null;
    private static int Next(int z, int by) => by > 0 ? Math.Min(6, z + (z < 2 ? 1 : 2)) : Math.Max(1, z - (z <= 2 ? 1 : 2));

    /// <summary>Zooms in or out around whatever is in the middle of the view now.</summary>
    private async Task ZoomBy(int by)
    {
        focus = await JS.InvokeAsync<double[]>("mandala.zoomCenter", zoomView);
        zoom = Next(zoom, by);
    }

    /// <summary>Clicking the picture zooms in on the spot clicked.</summary>
    private async Task ZoomAtClick(MouseEventArgs e)
    {
        if (zoom >= 6) return;
        focus = await JS.InvokeAsync<double[]>("mandala.zoomPoint", zoomView, e.ClientX, e.ClientY);
        zoom = Next(zoom, 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focus is { Length: 2 } f && viewing != null)
        {
            focus = null;
            await JS.InvokeVoidAsync("mandala.zoomTo", zoomView, f[0], f[1]);
        }
    }

    private void Step(int by)
    {
        if (viewing == null) return;
        int i = items.IndexOf(viewing) + by;
        if (i < 0 || i >= items.Count) return;
        viewing = items[i];
        zoom = 1;
    }

    private void ZoomKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": Close(); break;
            case "ArrowLeft": Step(-1); break;
            case "ArrowRight": Step(1); break;
            case "+" or "=": _ = ZoomBy(1); break;
            case "-": _ = ZoomBy(-1); break;
            case " " when viewing?.SavedId == null: viewing!.Picked = !viewing.Picked; break;
        }
    }

    private void SelectAll()
    {
        foreach (var i in items) if (i.SavedId == null) i.Picked = true;
    }

    private void SelectNone()
    {
        foreach (var i in items) i.Picked = false;
    }

    private int PickedCount => items.Count(i => i.Picked && i.SavedId == null);

    protected override async Task OnInitializedAsync()
    {
        settings = AppSettings.FromJson(await JS.InvokeAsync<string?>("mandala.load", SettingsKey));
    }

    private Item Make()
    {
        var doc = style == "lineart"
            ? RandomMandala.CreateLineArt(rng, 200, settings.Weight, difficulty)
            : RandomMandala.CreateIntricate(rng, 200, settings.Weight, difficulty);
        string svg = SvgWriter.Export(doc, coloringPage: true);
        return new Item { Doc = doc, Svg = svg, DataUrl = "data:image/svg+xml;charset=utf-8," + Uri.EscapeDataString(svg) };
    }

    /// <summary>Generates designs one at a time, letting the page update in between so the grid fills in as it goes.</summary>
    private async Task Fill(IList<int> slots)
    {
        busy = true;
        made = 0;
        target = slots.Count;
        foreach (int slot in slots)
        {
            await Task.Delay(1); // let the page draw the tiles made so far
            var item = Make();
            if (slot < items.Count) items[slot] = item; else items.Add(item);
            made++;
            StateHasChanged();
        }
        busy = false;
    }

    private async Task GenerateAll()
    {
        if (items.Any(i => i.Picked && i.SavedId == null) &&
            !await JS.InvokeAsync<bool>("mandala.confirm", "You have picked designs that aren't saved yet. Replace the whole batch anyway?"))
            return;
        items.Clear();
        await Fill(Enumerable.Range(0, howMany).ToList());
        message = $"Made {items.Count} designs. Click the ones you like, then 💾 Save. Use ↻ Replace the rest to try again on the others.";
    }

    private async Task ReplaceUnpicked()
    {
        var slots = Enumerable.Range(0, items.Count).Where(i => !items[i].Picked && items[i].SavedId == null).ToList();
        await Fill(slots);
        message = $"Replaced {slots.Count} design{(slots.Count == 1 ? "" : "s")}; your picks stayed put.";
    }

    private async Task Reroll(Item item)
    {
        int i = items.IndexOf(item);
        if (i < 0) return;
        await Fill(new[] { i });
        if (viewing == item) viewing = items[i];
    }

    private void TogglePick(Item item)
    {
        if (busy || item.SavedId != null) return;
        item.Picked = !item.Picked;
    }

    private async Task<bool> Save(Item item)
    {
        try
        {
            var created = await Api.CreateAsync(null, item.Doc.ToJson(), item.Svg);
            item.SavedId = created.Id;
            item.Name = created.Name;
            item.Picked = false;
            return true;
        }
        catch (Exception ex)
        {
            message = "Couldn't save: " + ex.Message;
            return false;
        }
    }

    private async Task SavePicked()
    {
        busy = true;
        var picked = items.Where(i => i.Picked && i.SavedId == null).ToList();
        int saved = 0;
        foreach (var item in picked)
        {
            if (!await Save(item)) break;
            saved++;
            StateHasChanged();
        }
        busy = false;
        if (saved > 0)
        {
            var names = picked.Where(p => p.SavedId != null).Select(p => p.Name).ToList();
            message = $"Saved {saved} design{(saved == 1 ? "" : "s")} ({names.First()}{(names.Count > 1 ? $" to {names.Last()}" : "")}). They're in 🖼 Gallery.";
        }
    }

    private async Task EditOne(Item item)
    {
        busy = true;
        bool ok = await Save(item);
        busy = false;
        if (ok) Nav.NavigateTo($"d/{item.SavedId}");
    }
}
