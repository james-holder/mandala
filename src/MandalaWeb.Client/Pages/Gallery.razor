@page "/gallery"
@inject DesignApi Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Saved designs · Mandala Maker</PageTitle>

<header class="toolbar">
    <div class="brand">Mandala Maker</div>
    <div class="group">
        <a class="button" href="">← Back to designing</a>
        <a class="button" href="batch">▦ Batch</a>
    </div>
    <div class="group">
        <button @onclick="SelectAll" title="Select every design in this folder, oldest first">Select all</button>
        <button @onclick="SelectNone">Select none</button>
        <select class="move-to" value="" @onchange="MoveSelected" disabled="@(order.Count == 0)" title="Move the selected designs into a folder">
            <option value="">Move @order.Count selected to…</option>
            @foreach (var f in folders) { <option value="@f.Id">📁 @f.Name</option> }
            <option value="none">Unfiled</option>
        </select>
    </div>
    <span class="count">@designs.Count saved · @order.Count selected</span>
</header>

<main class="gallery-page">
    <section class="export-bar">
        <label>File name / prefix <input @bind="prefix" @bind:event="oninput" placeholder="Mandalas" /></label>
        <label>Export as
            <select @bind="mode">
                <option value="kdp">Amazon KDP book interior</option>
                <option value="single">One PDF</option>
                <option value="separate">A PDF per design</option>
            </select>
        </label>
        @if (mode == "kdp")
        {
            <label>Trim size
                <select @bind="trim">
                    @foreach (var t in TrimSizes) { <option value="@t.Key">@t.Key in</option> }
                </select>
            </label>
        }
        else
        {
            <label>Paper
                <select @bind="paper">
                    <option value="letter">Letter</option>
                    <option value="a4">A4</option>
                    <option value="legal">Legal</option>
                    <option value="a5">A5</option>
                </select>
            </label>
        }
        <label class="radio" title="Each design gets an empty back, so markers can't bleed through onto the next design">
            <input type="checkbox" @bind="blankBacks" disabled="@(mode == "separate")" /> Blank back after each design
        </label>
        <button @onclick="PreviewBook" disabled="@(order.Count == 0 || busy)" title="See the PDF before downloading it">👁 Preview</button>
        <button class="primary" @onclick="Export" disabled="@(order.Count == 0 || busy)">
            @(busy ? "Making PDF…" : $"Export {order.Count} to PDF")
        </button>
    </section>

    @if (mode == "kdp")
    {
        <section class="kdp">
            <div class="kdp-fields">
                <label>Book title <input @bind="title" @bind:event="oninput" placeholder="Leave empty for no title page" /></label>
                <label>Subtitle <input @bind="subtitle" @bind:event="oninput" placeholder="Relaxing Mandalas for Adults" /></label>
                <label>Author <input @bind="author" @bind:event="oninput" placeholder="Candace Holder" /></label>
                <label class="radio"><input type="checkbox" @bind="belongsTo" /> "This book belongs to" page</label>
            </div>
            <ul class="preflight">
                @foreach (var check in Preflight())
                {
                    <li class="@(check.Ok ? "ok" : "warn")">@(check.Ok ? "✓" : "⚠") @check.Text</li>
                }
            </ul>
        </section>

        <section class="cover">
            <div class="cover-head">
                <h3>Cover <small>back · spine · front, with bleed. Uses the title, subtitle and author above.</small></h3>
                <div class="row" style="margin:0">
                    <button @onclick="PreviewCover" disabled="@(order.Count == 0 || busy)">👁 Preview</button>
                    <button class="primary" @onclick="ExportCover" disabled="@(order.Count == 0 || busy)">@(busy ? "Working…" : "Export cover PDF")</button>
                </div>
            </div>
            @if (order.Count == 0)
            {
                <div class="cover-start">
                    <p>Pick the designs for this book first; the cover's spine width depends on how many pages the book has.</p>
                    <button class="primary" @onclick="SelectAll">Select all designs</button>
                    <span class="help">or click designs below to choose them one by one</span>
                </div>
            }
            else
            {
                <div class="cover-grid">
                    <div class="cover-fields">
                        <label>Front design
                            <select value="@frontId" @onchange="e => { frontId = long.Parse(e.Value!.ToString()!); coverDirty = true; }">
                                @foreach (var id in order)
                                {
                                    var d = designs.FirstOrDefault(x => x.Id == id);
                                    if (d != null) { <option value="@id">@d.Name</option> }
                                }
                            </select>
                        </label>
                        <label>Paper
                            <select value="@coverPaper" @onchange="e => { coverPaper = e.Value!.ToString()!; coverDirty = true; }">
                                <option value="white">White</option>
                                <option value="cream">Cream</option>
                            </select>
                        </label>
                        <label>Font
                            <select value="@coverFont" @onchange="e => { coverFont = e.Value!.ToString()!; coverDirty = true; }">
                                <option value="serif">Classic serif</option>
                                <option value="elegant">Elegant</option>
                                <option value="clean">Clean</option>
                                <option value="script">Script</option>
                            </select>
                        </label>
                        <div class="color-row">
                            <label>Background <input type="color" value="@coverBg" @onchange="e => { coverBg = e.Value!.ToString()!; coverDirty = true; }" /></label>
                            <label>Text <input type="color" value="@coverInk" @onchange="e => { coverInk = e.Value!.ToString()!; coverDirty = true; }" /></label>
                        </div>
                        <div class="swatches">
                            @foreach (var (bg, ink) in CoverPalettes)
                            {
                                var pair = (bg, ink);
                                <button class="swatch-btn" style="background:@bg;color:@ink" title="Use this color pair"
                                        @onclick="() => { coverBg = pair.bg; coverInk = pair.ink; coverDirty = true; }">Aa</button>
                            }
                        </div>
                        <label>Back cover text
                            <textarea rows="5" @bind="blurb" @bind:event="oninput" @bind:after="() => coverDirty = true"
                                      placeholder="Relax and unwind with 30 hand-crafted mandalas. Single-sided pages, so markers won't bleed through."></textarea>
                        </label>
                        <label class="radio"><input type="checkbox" checked="@backPreviews" @onchange="e => { backPreviews = (bool)e.Value!; coverDirty = true; }" /> Show sample designs on the back</label>
                        <p class="help">@coverInfo</p>
                    </div>
                    <div class="cover-preview">
                        <canvas @ref="coverCanvas"></canvas>
                        <p class="legend"><span class="trim">— trim</span> <span class="spine">— spine</span> <span class="safe">— keep text inside</span> <span class="bar">— barcode area</span> (guides don't print)</p>
                    </div>
                </div>
            }
        </section>
    }

    @if (order.Count > 0)
    {
        <section class="book-order">
            <h3>Page order <small>use the arrows to rearrange; this is the order in the PDF</small></h3>
            <ol>
                @for (int i = 0; i < order.Count; i++)
                {
                    int index = i;
                    var d = designs.FirstOrDefault(x => x.Id == order[index]);
                    if (d == null) continue;
                    <li>
                        <img src="api/designs/@d.Id/svg?v=@d.UpdatedUtc.Ticks" alt="" />
                        <span>@(index + 1). @d.Name</span>
                        <button @onclick="() => Move(index, -1)" disabled="@(index == 0)" title="Earlier">◀</button>
                        <button @onclick="() => Move(index, 1)" disabled="@(index == order.Count - 1)" title="Later">▶</button>
                    </li>
                }
            </ol>
        </section>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="message">@message</p>
    }

    @if (loading)
    {
        <p class="message">Loading saved designs…</p>
    }
    else if (designs.Count == 0)
    {
        <div class="empty">
            <h2>No saved designs yet</h2>
            <p>Make a mandala and press 💾 Save, or use ▦ Batch to make a dozen at once. They'll show up here.</p>
            <a class="button primary" href="">Start designing</a>
        </div>
    }
    else
    {
        <div class="library">
        <aside class="folders">
            <h3>Folders</h3>
            <div class="folder @(viewAll ? "active" : "")" @onclick="() => View(null, true)">🗂 All designs <span>@designs.Count</span></div>
            <div class="folder @(!viewAll && viewFolder == null ? "active" : "") @(dropTarget == 0 ? "drop" : "")" @onclick="() => View(null, false)"
                 @ondragover="() => dropTarget = 0" @ondragover:preventDefault="true" @ondragleave="() => dropTarget = null" @ondrop="() => DropOn(null)">
                📄 Unfiled <span>@designs.Count(d => d.FolderId == null)</span>
            </div>
            @foreach (var f in folders)
            {
                var folder = f;
                @if (renamingFolderId == folder.Id)
                {
                    <div class="rename">
                        <input @bind="folderText" @onkeydown="e => FolderRenameKey(e, folder)" />
                        <button @onclick="() => SaveFolderRename(folder)">✓</button>
                    </div>
                }
                else
                {
                    <div class="folder @(!viewAll && viewFolder == folder.Id ? "active" : "") @(dropTarget == folder.Id ? "drop" : "")" @onclick="() => View(folder.Id, false)"
                         @ondragover="() => dropTarget = folder.Id" @ondragover:preventDefault="true" @ondragleave="() => dropTarget = null" @ondrop="() => DropOn(folder.Id)">
                        📁 <span class="name" title="@folder.Name">@folder.Name</span> <span>@designs.Count(d => d.FolderId == folder.Id)</span>
                        <button class="mini" title="Rename" @onclick="() => StartFolderRename(folder)" @onclick:stopPropagation="true">✎</button>
                        <button class="mini" title="Delete folder (its designs go back to Unfiled)" @onclick="() => DeleteFolder(folder)" @onclick:stopPropagation="true">✕</button>
                    </div>
                }
            }
            <div class="rename new-folder">
                <input @bind="newFolder" @bind:event="oninput" @onkeydown="NewFolderKey" placeholder="New folder name" />
                <button @onclick="CreateFolder" disabled="@string.IsNullOrWhiteSpace(newFolder)" title="Make the folder">+</button>
            </div>
            <p class="help">Drag designs onto a folder to file them. Drag one that's selected to move all @order.Count selected.</p>
        </aside>
        <div class="cards">
            @if (!Visible.Any())
            {
                <p class="message">Nothing in this folder yet. Drag designs onto it from 🗂 All designs or 📄 Unfiled.</p>
            }
            @foreach (var d in Visible)
            {
                var design = d;
                int position = order.IndexOf(design.Id);
                <div class="card @(position >= 0 ? "chosen" : "") @(dragging.Contains(design.Id) ? "dragging" : "")" draggable="true"
                     @ondragstart="() => StartDrag(design.Id)" @ondragend="EndDrag">
                    <div class="thumb" @onclick="() => Toggle(design.Id)">
                        <img src="api/designs/@design.Id/svg?v=@design.UpdatedUtc.Ticks" alt="@design.Name" loading="lazy" draggable="false" />
                        @if (position >= 0) { <span class="badge">@(position + 1)</span> }
                        else { <span class="badge empty"></span> }
                    </div>
                    @if (renamingId == design.Id)
                    {
                        <div class="rename">
                            <input @bind="renameText" @onkeydown="e => RenameKey(e, design)" />
                            <button @onclick="() => SaveRename(design)">✓</button>
                        </div>
                    }
                    else
                    {
                        <div class="title" title="Click to rename" @onclick="() => StartRename(design)">@design.Name</div>
                    }
                    <div class="meta">@design.UpdatedUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")@if (viewAll && FolderName(design.FolderId) is string fn) {<span> · 📁 @fn</span>}</div>
                    <div class="actions">
                        <button @onclick='() => Nav.NavigateTo($"d/{design.Id}")'>Open</button>
                        <button @onclick="() => Delete(design)">Delete</button>
                    </div>
                </div>
            }
        </div>
        </div>
    }
</main>

<PdfPreview Url="@previewUrl" Title="@previewTitle" Note="@previewNote" Download="@previewDownload" OnClose="() => previewUrl = null" />

@code {
    // Common KDP trim sizes for coloring books (inches)
    private static readonly Dictionary<string, (double W, double H)> TrimSizes = new()
    {
        ["8.5 × 11"] = (8.5, 11),
        ["8.25 × 11"] = (8.25, 11),
        ["8 × 10"] = (8, 10),
        ["8.5 × 8.5"] = (8.5, 8.5),
        ["8.25 × 8.25"] = (8.25, 8.25),
        ["7 × 10"] = (7, 10),
        ["6 × 9"] = (6, 9),
    };

    private const double MinLineMm = 0.35; // KDP's minimum is 0.3 mm; this leaves a little room

    private List<DesignSummary> designs = new();
    private List<FolderSummary> folders = new();
    private bool viewAll = true;
    private long? viewFolder;       // with viewAll false: the folder shown, or null for Unfiled
    private long? dropTarget;       // folder being dragged over (0 = Unfiled), for highlighting
    private List<long> dragging = new();
    private string newFolder = "";
    private long? renamingFolderId;
    private string folderText = "";

    private IEnumerable<DesignSummary> Visible => viewAll ? designs : designs.Where(d => d.FolderId == viewFolder);
    private string? FolderName(long? id) => id is long f ? folders.FirstOrDefault(x => x.Id == f)?.Name : null;
    private readonly List<long> order = new(); // selected designs, in book order
    private bool loading = true;
    private bool busy;
    private string prefix = "Mandalas";
    private string paper = "letter";
    private string mode = "kdp";
    private string trim = "8.5 × 11";
    private bool blankBacks = true;
    private string title = "";
    private string subtitle = "";
    private string author = "";
    private bool belongsTo = true;
    private string? message;
    private long? renamingId;

    // ---------- Cover ----------
    private static readonly (string Bg, string Ink)[] CoverPalettes =
    {
        ("#ffffff", "#222222"), ("#1f2a44", "#f6e7c1"), ("#2e5e4e", "#fdf6e3"), ("#7b2d43", "#fbe9e7"),
        ("#f3e6d3", "#5a3e2b"), ("#e8f1f8", "#1f3a5f"), ("#3d2c5c", "#f4d58d"), ("#f7d6d0", "#6b2737"),
    };
    private ElementReference coverCanvas;
    private long? frontId;
    private string coverPaper = "white";
    private string coverFont = "elegant";
    private string coverBg = "#1f2a44";
    private string coverInk = "#f6e7c1";
    private string blurb = "";
    private bool backPreviews = true;
    private bool coverDirty = true;
    private string coverInfo = "";
    private string lastCoverKey = "";
    private readonly Dictionary<long, string> svgCache = new();
    private string? previewUrl;
    private string previewTitle = "";
    private string? previewNote;
    private EventCallback previewDownload;
    private string renameText = "";

    private string ExportName => string.IsNullOrWhiteSpace(prefix) ? "Mandalas" : CleanFileName(prefix);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            designs = await Api.ListAsync();
            folders = await Api.FoldersAsync();
        }
        catch (Exception ex) { message = "Couldn't load saved designs: " + ex.Message; }
        loading = false;
    }

    // ---------- Selection and page order ----------

    private void Toggle(long id)
    {
        if (!order.Remove(id)) order.Add(id);
        coverDirty = true;
    }

    // Oldest first, which is usually the order designs were made in
    private void SelectAll()
    {
        foreach (var d in Visible.OrderBy(d => d.Id))
            if (!order.Contains(d.Id)) order.Add(d.Id);
        coverDirty = true;
    }

    private void SelectNone() { order.Clear(); coverDirty = true; }

    // ---------- Folders ----------

    private void View(long? folder, bool all)
    {
        // A folder is usually one book, so its name becomes the file name unless one was typed
        string? before = viewAll ? null : FolderName(viewFolder);
        viewAll = all;
        viewFolder = folder;
        if (FolderName(folder) is string name && (prefix == "Mandalas" || prefix == before || string.IsNullOrWhiteSpace(prefix)))
            prefix = name;
    }

    private void StartDrag(long id)
    {
        // Dragging a selected design takes the whole selection along
        dragging = order.Contains(id) ? order.ToList() : new List<long> { id };
    }

    private void EndDrag()
    {
        dragging = new();
        dropTarget = null;
    }

    private async Task DropOn(long? folderId)
    {
        var ids = dragging;
        EndDrag();
        await MoveTo(ids, folderId);
    }

    private async Task MoveSelected(ChangeEventArgs e)
    {
        string v = e.Value?.ToString() ?? "";
        if (v == "") return;
        await MoveTo(order.ToList(), v == "none" ? null : long.Parse(v));
    }

    private async Task MoveTo(List<long> ids, long? folderId)
    {
        ids = ids.Where(id => designs.Any(d => d.Id == id && d.FolderId != folderId)).ToList();
        if (ids.Count == 0) return;
        try
        {
            await Api.MoveAsync(ids, folderId);
            for (int i = 0; i < designs.Count; i++)
                if (ids.Contains(designs[i].Id)) designs[i] = designs[i] with { FolderId = folderId };
            message = $"Moved {ids.Count} design{(ids.Count == 1 ? "" : "s")} to {FolderName(folderId) ?? "Unfiled"}.";
        }
        catch (Exception ex) { message = "Couldn't move: " + ex.Message; }
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolder)) return;
        try
        {
            var f = await Api.CreateFolderAsync(newFolder.Trim());
            folders.Add(f);
            folders.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
            newFolder = "";
            message = $"Made folder {f.Name}. Drag designs onto it to file them.";
        }
        catch (Exception ex) { message = "Couldn't make the folder: " + ex.Message; }
    }

    private async Task NewFolderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateFolder();
    }

    private void StartFolderRename(FolderSummary f)
    {
        renamingFolderId = f.Id;
        folderText = f.Name;
    }

    private async Task FolderRenameKey(KeyboardEventArgs e, FolderSummary f)
    {
        if (e.Key == "Enter") await SaveFolderRename(f);
        else if (e.Key == "Escape") renamingFolderId = null;
    }

    private async Task SaveFolderRename(FolderSummary f)
    {
        renamingFolderId = null;
        string name = CleanFileName(folderText);
        if (name.Length == 0 || name == f.Name) return;
        try
        {
            await Api.RenameFolderAsync(f.Id, name);
            if (prefix == f.Name) prefix = name;
            folders[folders.IndexOf(f)] = f with { Name = name };
        }
        catch (Exception ex) { message = "Couldn't rename the folder: " + ex.Message; }
    }

    private async Task DeleteFolder(FolderSummary f)
    {
        int count = designs.Count(d => d.FolderId == f.Id);
        string note = count == 0 ? "" : $" Its {count} design{(count == 1 ? "" : "s")} won't be deleted; they'll go back to Unfiled.";
        if (!await JS.InvokeAsync<bool>("mandala.confirm", $"Delete the folder \"{f.Name}\"?{note}")) return;
        try
        {
            await Api.DeleteFolderAsync(f.Id);
            folders.Remove(f);
            for (int i = 0; i < designs.Count; i++)
                if (designs[i].FolderId == f.Id) designs[i] = designs[i] with { FolderId = null };
            if (!viewAll && viewFolder == f.Id) View(null, true);
            message = $"Deleted folder {f.Name}.";
        }
        catch (Exception ex) { message = "Couldn't delete the folder: " + ex.Message; }
    }

    private void Move(int index, int delta)
    {
        int j = index + delta;
        if (j < 0 || j >= order.Count) return;
        (order[index], order[j]) = (order[j], order[index]);
        coverDirty = true;
    }

    // ---------- KDP pre-flight ----------

    private sealed record Check(bool Ok, string Text);

    /// <summary>The page count the KDP export will produce, matching the layout in mandala.js.</summary>
    private int KdpPageCount()
    {
        int n = 0;
        if (!string.IsNullOrWhiteSpace(title)) n += 2;
        if (belongsTo) n += 2;
        n += blankBacks ? order.Count * 2 : order.Count;
        if (n % 2 == 1) n++;
        return n;
    }

    private IEnumerable<Check> Preflight()
    {
        int pages = KdpPageCount();
        double gutter = pages <= 150 ? 0.375 : pages <= 300 ? 0.5 : pages <= 500 ? 0.625 : pages <= 700 ? 0.75 : 0.875;
        int designsNeeded = (int)Math.Ceiling((24 - (pages - (blankBacks ? order.Count * 2 : order.Count))) / (blankBacks ? 2.0 : 1.0));
        yield return pages >= 24
            ? new Check(true, $"{pages} pages (KDP needs at least 24)")
            : new Check(false, $"Only {pages} pages. KDP needs at least 24, so add about {Math.Max(1, designsNeeded - order.Count)} more design(s)");
        if (pages > 828) yield return new Check(false, $"{pages} pages is over KDP's limit of 828");
        yield return new Check(true, $"Trim {trim} in, no bleed. Art stays inside the margins: {gutter + 0.375}\" from the spine (KDP minimum {gutter}\"), 0.5\" outside, top and bottom");
        yield return new Check(true, $"Lines thinner than {MinLineMm} mm are thickened (KDP minimum: 0.3 mm)");
        yield return new Check(true, "Title page text is drawn as a 300 DPI image, so there are no fonts to embed");
        if (!blankBacks) yield return new Check(false, "No blank backs: markers can bleed through to the design on the other side");
        if (string.IsNullOrWhiteSpace(title)) yield return new Check(false, "No title page. Most coloring books have one (add a book title above)");
    }

    // ---------- Cover ----------

    /// <summary>
    /// The design's coloring page, drawn fresh from its saved data (not the stored thumbnail), so older designs
    /// get the latest improvements, like being trimmed to fill the page.
    /// </summary>
    private async Task<string> Svg(long id)
    {
        if (!svgCache.TryGetValue(id, out var svg))
        {
            try { svg = SvgWriter.Export(MandalaDocument.FromJson(await Api.GetJsonAsync(id)), coloringPage: true); }
            catch (Exception) { svg = await Api.GetSvgAsync(id); } // fall back to the stored picture
            svgCache[id] = svg;
        }
        return svg;
    }

    private async Task<object> CoverSpec()
    {
        long front = frontId is long f && order.Contains(f) ? f : order[0];
        frontId = front;
        var back = new List<string>();
        if (backPreviews)
            foreach (var id in order.Where(id => id != front).Take(4)) back.Add(await Svg(id));
        var (w, h) = TrimSizes[trim];
        return new
        {
            trimW = w, trimH = h, pages = Math.Max(24, KdpPageCount()), paper = coverPaper,
            bg = coverBg, ink = coverInk, font = coverFont,
            title = title.Trim(), subtitle = subtitle.Trim(), author = author.Trim(), blurb = blurb.Trim(),
            frontSvg = await Svg(front), backSvgs = back,
        };
    }

    private sealed record CoverSize(double WidthIn, double HeightIn, double SpineIn, string? Url);

    private string CoverInfo(CoverSize size)
    {
        int pages = Math.Max(24, KdpPageCount());
        string spineText = pages >= 80 ? "Spine text: title and author." : $"No spine text (KDP only prints it on books over 79 pages; this one has {pages}).";
        return $"Full cover {size.WidthIn:0.###} × {size.HeightIn:0.###} in, spine {size.SpineIn:0.###} in for {pages} pages on {coverPaper} paper. {spineText}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (mode != "kdp" || order.Count == 0) return;
        // Redraw when anything that affects the cover has changed
        string key = string.Join("|", coverDirty, title, subtitle, author, trim, blurb, blankBacks, belongsTo, string.Join(",", order));
        if (!coverDirty && key == lastCoverKey) return;
        lastCoverKey = key;
        coverDirty = false;
        try
        {
            var size = await JS.InvokeAsync<CoverSize>("mandalaCover.preview", coverCanvas, await CoverSpec());
            string info = CoverInfo(size);
            if (info != coverInfo) { coverInfo = info; StateHasChanged(); }
        }
        catch (Exception ex) { coverInfo = "Couldn't draw the cover preview: " + ex.Message; StateHasChanged(); }
    }

    private async Task ExportCover()
    {
        if (order.Count == 0) return;
        busy = true;
        message = null;
        StateHasChanged();
        try
        {
            var size = await JS.InvokeAsync<CoverSize>("mandalaCover.exportPdf", await CoverSpec(), ExportName + "-cover", false);
            message = $"Exported {ExportName}-cover.pdf ({size.WidthIn:0.###} × {size.HeightIn:0.###} in, 300 DPI). Upload it as the paperback cover in KDP.";
            if (KdpPageCount() < 24) message += " Note: the book is under 24 pages, so the spine was sized for 24.";
        }
        catch (Exception ex) { message = "Cover export failed: " + ex.Message; }
        busy = false;
        coverDirty = true;
    }

    // ---------- Rename and delete ----------

    private void StartRename(DesignSummary d) { renamingId = d.Id; renameText = d.Name; }

    private async Task RenameKey(KeyboardEventArgs e, DesignSummary d)
    {
        if (e.Key == "Enter") await SaveRename(d);
        else if (e.Key == "Escape") renamingId = null;
    }

    private async Task SaveRename(DesignSummary d)
    {
        string name = CleanFileName(renameText);
        renamingId = null;
        if (name.Length == 0 || name == d.Name) return;
        try
        {
            await Api.RenameAsync(d.Id, name);
            designs[designs.IndexOf(d)] = d with { Name = name };
        }
        catch (Exception ex) { message = "Couldn't rename: " + ex.Message; }
    }

    private async Task Delete(DesignSummary d)
    {
        if (!await JS.InvokeAsync<bool>("mandala.confirm", $"Delete \"{d.Name}\"? This can't be undone.")) return;
        try
        {
            await Api.DeleteAsync(d.Id);
            designs.Remove(d);
            order.Remove(d.Id);
            message = $"Deleted {d.Name}.";
        }
        catch (Exception ex) { message = "Couldn't delete: " + ex.Message; }
    }

    // ---------- Export ----------

    private sealed record PdfPage(string Name, string Svg);
    private sealed record KdpResult(int Pages, double GutterIn, string? Url);

    private async Task<List<PdfPage>> BookPages()
    {
        var pages = new List<PdfPage>();
        foreach (long id in order)
            pages.Add(new PdfPage(designs.First(x => x.Id == id).Name, await Svg(id)));
        return pages;
    }

    private object KdpOptions(bool preview)
    {
        var (w, h) = TrimSizes[trim];
        return new
        {
            trimW = w, trimH = h,
            title = title.Trim(), subtitle = subtitle.Trim(), author = author.Trim(),
            belongsTo, blankBacks, minLineMm = MinLineMm, preview,
        };
    }

    private async Task PreviewBook()
    {
        if (order.Count == 0) return;
        busy = true;
        message = null;
        StateHasChanged();
        try
        {
            var pages = await BookPages();
            if (mode == "kdp")
            {
                var result = await JS.InvokeAsync<KdpResult>("mandala.exportKdp", pages, ExportName, KdpOptions(true));
                previewUrl = result.Url;
                previewNote = $"{result.Pages} pages at {trim} in. Blank backs and margins are shown exactly as they'll print.";
            }
            else
            {
                previewUrl = await JS.InvokeAsync<string>("mandala.exportPdf", pages, ExportName, paper, mode, blankBacks && mode == "single", true);
                previewNote = mode == "separate" ? "Shown together here; the download is one PDF per design." : null;
            }
            previewTitle = $"{ExportName}.pdf";
            previewDownload = EventCallback.Factory.Create(this, async () => { previewUrl = null; await Export(); });
        }
        catch (Exception ex) { message = "Preview failed: " + ex.Message; }
        busy = false;
    }

    private async Task PreviewCover()
    {
        if (order.Count == 0) return;
        busy = true;
        StateHasChanged();
        try
        {
            var size = await JS.InvokeAsync<CoverSize>("mandalaCover.exportPdf", await CoverSpec(), ExportName + "-cover", true);
            previewUrl = size.Url;
            previewTitle = $"{ExportName}-cover.pdf";
            previewNote = $"{size.WidthIn:0.###} × {size.HeightIn:0.###} in with bleed. Back cover on the left, front on the right.";
            previewDownload = EventCallback.Factory.Create(this, async () => { previewUrl = null; await ExportCover(); });
        }
        catch (Exception ex) { message = "Cover preview failed: " + ex.Message; }
        busy = false;
    }

    private async Task Export()
    {
        if (order.Count == 0) return;
        busy = true;
        message = null;
        StateHasChanged();
        try
        {
            var pages = await BookPages();

            if (mode == "kdp")
            {
                var result = await JS.InvokeAsync<KdpResult>("mandala.exportKdp", pages, ExportName, KdpOptions(false));
                message = $"Exported {ExportName}.pdf: a {result.Pages}-page KDP interior at {trim} in, ready to upload as the manuscript.";
            }
            else
            {
                await JS.InvokeVoidAsync("mandala.exportPdf", pages, ExportName, paper, mode, blankBacks && mode == "single", false);
                message = mode == "single"
                    ? $"Exported {pages.Count} design{(pages.Count == 1 ? "" : "s")} to {ExportName}.pdf."
                    : $"Exported {ExportName}_001.pdf to {ExportName}_{pages.Count:000}.pdf. (If your browser asks, allow multiple downloads.)";
            }
        }
        catch (Exception ex) { message = "Export failed: " + ex.Message; }
        busy = false;
    }

    private static string CleanFileName(string s) =>
        new string(s.Trim().Where(c => !"\\/:*?\"<>|".Contains(c) && !char.IsControl(c)).ToArray());
}
